# Скопируйте в .env. Без OPENAI_API_KEY AI работает в mock-режиме.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol
# модель для вопросов (быстрее); пусто = gpt-5.4-mini в Compose, при go run — та же, что OPENAI_MODEL
OPENAI_MODEL_FAST=gpt-5.4-mini
# Порт приложения на хосте для docker compose (по умолчанию 8080)
APP_PORT=8080
# Для локального запуска (go run ./cmd/server) при `make db`:
DATABASE_URL=postgres://postgres:hack@localhost:5432/hack?sslmode=disable
